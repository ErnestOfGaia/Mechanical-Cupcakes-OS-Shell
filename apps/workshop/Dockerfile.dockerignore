# BuildKit reads <dockerfile>.dockerignore when the context is the repo root.
# Paths are relative to the CONTEXT (repo root), not to this file.
**/node_modules
**/.next
**/out
**/.env
**/.env.local
**/*.tsbuildinfo
.git
apps/workshop/lib/*.test.ts
apps/workshop/vitest.config.ts
# The MCP server and the migration script are local dev tools. They reach the vault
# directly, so they must never be inside a deployed image — the deployed copy is the
# browser-only client build and has no vault to reach.
apps/workshop/mcp
apps/workshop/scripts
