{
  "name": "mcos-workshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint .",
    "test": "vitest run",
    "mcp:build": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=mcp/dist/workshop-mcp.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "mcp:dev": "tsx mcp/server.ts",
    "test:mcp": "npm run mcp:build && vitest run mcp"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "latest",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5",
    "zod": "^3.25.76"
  }
}
