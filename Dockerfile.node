FROM node:22-alpine
WORKDIR /app
# L10: the commit this image was built from, baked in by CI (build-arg GIT_SHA)
# and reported by /health as `commit`. "unknown" means a local build — the
# drift checker treats that as a finding, never as a pass.
ARG GIT_SHA=unknown
ENV MCOS_BUILD_SHA=$GIT_SHA
COPY package.json package-lock.json ./
RUN npm install --ignore-scripts
COPY . .
RUN npm run build
EXPOSE 3000
EXPOSE 4111
CMD ["npm", "start"]
